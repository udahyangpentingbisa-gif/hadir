generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  REPAID
}

enum AbsenceKind {
  LEAVE
  EXPLANATION
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String          @id @default(cuid())
  name           String
  username       String          @unique
  email          String?         @unique
  password       String
  role           Role            @default(EMPLOYEE)
  createdAt      DateTime        @default(now()) @map("created_at")
  attendances    Attendance[]
  loans          Loan[]
  payPeriods     PayPeriod[]
  absenceReports AbsenceReport[]

  @@map("users")
}

model PayPeriod {
  id             String          @id @default(cuid())
  employeeId     String          @map("employee_id")
  periodName     String          @map("period_name")
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  isActive       Boolean         @default(false) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  employee       User            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendances    Attendance[]
  loans          Loan[]
  absenceReports AbsenceReport[]

  @@index([isActive])
  @@index([employeeId, isActive])
  @@map("pay_periods")
}

model Attendance {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  periodId   String           @map("period_id")
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  wageEarned Int              @default(50000) @map("wage_earned")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  period     PayPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([userId, periodId])
  @@map("attendances")
}

model Loan {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  periodId  String     @map("period_id")
  amount    Int
  status    LoanStatus @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    PayPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("loans")
}

model AbsenceReport {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  periodId        String        @map("period_id")
  date            DateTime      @db.Date
  kind            AbsenceKind
  reason          String
  status          AbsenceStatus @default(PENDING)
  salaryDeduction Int           @default(0) @map("salary_deduction")
  createdAt       DateTime      @default(now()) @map("created_at")
  reviewedAt      DateTime?     @map("reviewed_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          PayPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([periodId, status])
  @@map("absence_reports")
}
