# Neon > Project > Dashboard > Connect > pilih pooled connection untuk runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct connection dari Neon untuk Prisma Migrate dan seed
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-secret-minimal-32-karakter"
# Hanya digunakan saat seed membuat akun admin baru; tidak mengubah akun yang sudah ada.
ADMIN_INITIAL_PASSWORD="admin123"
# Neon Auth Console / integration endpoint
NEON_AUTH_BASE_URL="https://<project-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://<project-endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Neon Console > Postgres database > Realtime
NEON_REALTIME_URL="wss://<project-endpoint>.rt.<region>.aws.neon.tech/"
NEON_REALTIME_SECRET="salin-dari-neon-console"
